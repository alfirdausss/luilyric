{
  "name": "luilyric",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "LuiLyric Stage A — Portable Web Lyric Engine, Single-Line Alpha Renderer, and Stage Controller",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx tests/core.test.ts",
    "electron:build": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "electron:start": "npm run build && npm run electron:build && electron dist-electron/main.js",
    "build:portable": "npm run build && npm run electron:build && node scripts/build-portable.cjs"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.3.0",
    "lucide-react": "^0.454.0",
    "object-hash": "^3.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scheduler": "^0.28.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.8.0",
    "electron-packager": "^17.1.2",
    "postcss": "^8.5.30",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "ws": "^8.22.0"
  }
}
